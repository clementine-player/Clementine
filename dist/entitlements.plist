<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Homebrew-provided frameworks/dylibs (Qt, GStreamer, Sparkle, Breakpad, ...) are
       not signed with the same Team ID as this build, so hardened runtime's library
       validation has to be relaxed or the app refuses to load them at launch. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- GStreamer's plugin scanner and codec plugins are loaded from paths outside the
       bundle in some configurations. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
