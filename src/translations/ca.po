#: ../bin/src/ui_filenameformatwidget.h:117
msgid ""
"<p>Tokens start with %, for example: %artist %album %title </p>\n"
"\n"
"<p>If you surround sections of text that contain a token with curly-braces, that section will be hidden if the token is empty.</p>"
msgstr "<p>Les fitxes de reemplaçament comencen amb %, per exemple: %artist %album %title </p>\n\n<p>Si demarqueu entre claus una secció de text que contingui una fitxa de reemplaçament, aquesta secció no es mostrarà si la fitxa de reemplaçament es troba buida.</p>"

