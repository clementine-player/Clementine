{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-cpp.sh\"",
            "statusMessage": "Running clang-format"
          }
        ]
      }
    ]
  }
}
